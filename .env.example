# Copy to .env.local. Never put secrets in NEXT_PUBLIC_* vars: they ship to the browser.
# Everything here is optional. With no .env.local at all, Redline runs on live data.

# --- Data layer --------------------------------------------------------------
# unset/false = live data (lib/data/live.ts): FuelEconomy.gov, NHTSA, EIA.
# true        = seeded mock data (lib/data/mock). Tests always use this.
USE_MOCK_DATA=false

# Mock-only knobs (ignored unless USE_MOCK_DATA=true)
# Simulates the MarketCheck monthly limit being hit, so prices show as stale.
MOCK_MARKETCHECK_LIMIT_HIT=false
# Set to 0 to turn off the artificial latency that makes loading states visible.
MOCK_LATENCY=1

# --- Live APIs (server-side only) --------------------------------------------
# Free key: https://www.eia.gov/opendata/register.php
# Without it, gas uses FuelEconomy.gov's U.S. average instead of the WA average.
EIA_API_KEY=
# Not wired up yet. Market value uses typical WA listings until it is.
MARKETCHECK_API_KEY=
# FuelEconomy.gov and NHTSA (vPIC, recalls, complaints) need no key.

# --- Supabase (server-side only, not connected yet) --------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
