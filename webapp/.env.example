# Copy to .env.local and fill in. Everything here is optional:
# Redline runs without any keys, using fallbacks noted below.

# EIA Open Data API key (free: https://www.eia.gov/opendata/register.php).
# Enables live Washington State gas and electricity prices.
# Without it, Redline uses FuelEconomy.gov's live national average prices.
EIA_API_KEY=

# Default state/region for fees and fuel prices. Only WA is modeled right now.
REDLINE_STATE=WA
